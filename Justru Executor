-- Function to refresh the file list sidebar
local function refreshFileList()
	for _, child in ipairs(fileListScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	if listfiles then
		local success, files = pcall(listfiles, "JustruWorkspace")
		if success and files then
			for _, filePath in ipairs(files) do
				local fileName = filePath:match("([^/]+)$") or filePath:match("([^\\]+)$")
				
				local fileBtn = Instance.new("TextButton")
				fileBtn.Size = UDim2.new(1, 0, 0, 28)
				fileBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
				fileBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
				fileBtn.TextSize = 13
				fileBtn.Font = Enum.Font.Code
				fileBtn.Text = fileName
				fileBtn.Parent = fileListScroll

				local btnCorner = Instance.new("UICorner")
				btnCorner.CornerRadius = UDim.new(0, 3)
				btnCorner.Parent = fileBtn

				-- Load script on click
				fileBtn.MouseButton1Click:Connect(function()
					local readSuccess, content = pcall(readfile, filePath)
					if readSuccess and content then
						codeBox.Text = content
						fileNameBox.Text = fileName
					end
				end)
			end
		end
	end
end

-- Save Script Logic
saveBtn.MouseButton1Click:Connect(function()
	local fileName = fileNameBox.Text
	if fileName == "" then
		fileName = "script_" .. math.random(1000, 9999) .. ".lua"
		fileNameBox.Text = fileName
	end
	
	if not string.match(fileName, "%.lua$") then
		fileName = fileName .. ".lua"
	end

	if writefile then
		pcall(writefile, "JustruWorkspace/" .. fileName, codeBox.Text)
		refreshFileList()
	end
end)

-- Execute Logic
executeBtn.MouseButton1Click:Connect(function()
	local source = codeBox.Text
	local func, err = loadstring(source)
	if func then
		local success, runtimeErr = pcall(func)
		if not success then
			warn("[Justru Runtime Error]: " .. tostring(runtimeErr))
		end
	else
		warn("[Justru Compile Error]: " .. tostring(err))
	end
end)

